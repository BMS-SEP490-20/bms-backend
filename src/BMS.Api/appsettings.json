{
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "BMS_Database",
    "UsersCollectionName": "accounts",
    "RolesCollectionName": "roles",
    "RefreshTokensCollectionName": "refresh_tokens"
  },
  "Jwt": {
    "Issuer": "BMS.Api",
    "Audience": "BMS.Client",
    "SecretKey": "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "LoginPermitPerMinute": 10
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
