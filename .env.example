# ==============================================================================
# BMS BACKEND ENVIRONMENT VARIABLES (Single Source of Truth)
# Copy this file to .env and fill real values. Never commit .env to git.
# ==============================================================================

# 1. Database (MongoDB)
MongoDB__ConnectionString=mongodb://localhost:27017
MongoDB__DatabaseName=BMS_Database

# 2. JWT Authentication (at least 32 bytes)
Jwt__SecretKey=REPLACE_WITH_AT_LEAST_32_BYTE_RANDOM_SECRET_KEY

# 3. Google OAuth 2.0 (Frontend auto-fetches ClientId via GET /api/auth/public-config)
# Leave empty to hide Google Sign-In button cleanly.
Google__ClientId=
Google__ClientSecret=

# 4. SMTP Email (Unified for OTP, Password Reset, Appointment & Result Notifications)
Email__Host=smtp.gmail.com
Email__Port=587
Email__EnableSsl=true
Email__Username=your-clinic-email@gmail.com
Email__Password=your-16-char-gmail-app-password
Email__FromAddress=your-clinic-email@gmail.com
Email__FromName=Hệ Thống Xét Nghiệm Y Khoa BMS

# 5. SePay Bank Transfer
SePay__AccountNumber=
SePay__BankCode=VietinBank
SePay__AccountName=
SePay__PaymentPrefix=SEVQR
SePay__WebhookApiKey=
